#include <iostream>
using namespace std;

int main() {
    int n, cost[10][10], dist[10], visited[10] = {0};
    int source;

    cin >> n;

    for(int i = 0; i < n; i++)
        for(int j = 0; j < n; j++)
            cin >> cost[i][j];

    cin >> source;

    for(int i = 0; i < n; i++)
        dist[i] = 9999;

    dist[source] = 0;

    for(int count = 0; count < n; count++) {
        int u = -1, min = 9999;

        for(int i = 0; i < n; i++) {
            if(!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        if(u == -1) break;

        visited[u] = 1;

        for(int v = 0; v < n; v++) {
            if(!visited[v] && cost[u][v] != 0 &&
               dist[u] + cost[u][v] < dist[v]) {
                dist[v] = dist[u] + cost[u][v];
            }
        }
    }

    for(int i = 0; i < n; i++)
        cout << dist[i] << " ";

    return 0;
}
