#include <iostream>
using namespace std;

int main() {
    int n, e, u[20], v[20], w[20], p[10];
    cin >> n >> e;

    for(int i=0;i<n;i++)
        p[i] = i;

    for(int i=0;i<e;i++)
        cin >> u[i] >> v[i] >> w[i];

    // Sort edges by weight
    for(int i=0;i<e;i++)
        for(int j=0;j<e-i-1;j++)
            if(w[j] > w[j+1]) {
                swap(w[j],w[j+1]);
                swap(u[j],u[j+1]);
                swap(v[j],v[j+1]);
            }

    int total = 0, count = 0;

    for(int i=0;i<e;i++) {
        int a = u[i], b = v[i];

        while(p[a] != a) a = p[a];
        while(p[b] != b) b = p[b];

        if(a != b) {
            cout << u[i] << " - " << v[i] << " : " << w[i] << endl;
            p[a] = b;
            total += w[i];
            count++;
        }

        if(count == n-1) break;
    }

    cout << "Total cost = " << total;
}
