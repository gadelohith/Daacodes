#include <iostream>
using namespace std;

int main() {
    int n, f[20], p[20], l[20], r[20];
    char ch[20];

    cin >> n;

    for(int i=0;i<n;i++) {
        cin >> ch[i] >> f[i];
        p[i] = -1;
    }

    for(int i=n;i<2*n-1;i++) {
        int a=-1, b=-1;

        for(int j=0;j<i;j++)
            if(p[j]==-1) {
                if(a==-1 || f[j]<f[a]) {
                    b=a;
                    a=j;
                }
                else if(b==-1 || f[j]<f[b])
                    b=j;
            }

        f[i]=f[a]+f[b];
        p[a]=p[b]=i;
        l[i]=a;
        r[i]=b;
        p[i]=-1;
    }

    for(int i=0;i<n;i++) {
        int j=i;
        cout << ch[i] << " : ";

        while(p[j]!=-1) {
            int par=p[j];
            if(l[par]==j) cout << "0";
            else cout << "1";
            j=par;
        }
        cout << endl;
    }
}
