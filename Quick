#include <iostream>
using namespace std;

void quick(int a[], int low, int high) {
    if(low >= high) return;

    int pivot = a[high];
    int i = low-1;

    for(int j=low;j<high;j++)
        if(a[j] < pivot) {
            i++;
            swap(a[i],a[j]);
        }

    swap(a[i+1],a[high]);

    int p = i+1;

    quick(a,low,p-1);
    quick(a,p+1,high);
}

int main() {
    int n, a[100];
    cin >> n;

    for(int i=0;i<n;i++)
        cin >> a[i];

    quick(a,0,n-1);

    for(int i=0;i<n;i++)
        cout << a[i] << " ";
}
