#include <iostream>
using namespace std;

int main() {
    int n, a[100];
    cin >> n;

    for(int i=0;i<n;i++)
        cin >> a[i];

    for(int i=0;i<n;i++) {
        int min = i;

        for(int j=i+1;j<n;j++)
            if(a[j] < a[min])
                min = j;

        swap(a[i],a[min]);
    }

    for(int i=0;i<n;i++)
        cout << a[i] << " ";
}
