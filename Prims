#include <iostream>
using namespace std;

int main() {
    int n, cost[10][10], vis[10] = {0};
    cin >> n;

    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++)
            cin >> cost[i][j];

    vis[0] = 1;
    int edges = 0, total = 0;

    while(edges < n-1) {
        int min = 999, u = -1, v = -1;

        for(int i=0;i<n;i++) {
            if(vis[i])
                for(int j=0;j<n;j++)
                    if(!vis[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        u = i;
                        v = j;
                    }
        }

        cout << u << " - " << v << " : " << min << endl;
        vis[v] = 1;
        total += min;
        edges++;
    }

    cout << "Total cost = " << total;
}
