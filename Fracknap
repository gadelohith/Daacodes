#include <iostream>
using namespace std;

int main() {
    int n, W;
    float weight[10], value[10], ratio[10];

    cout << "Enter number of items: ";
    cin >> n;

    for(int i = 0; i < n; i++) {
        cin >> weight[i] >> value[i];
        ratio[i] = value[i] / weight[i];
    }

    cout << "Enter capacity: ";
    cin >> W;

    // Sort based on ratio
    for(int i = 0; i < n; i++) {
        for(int j = i+1; j < n; j++) {
            if(ratio[i] < ratio[j]) {
                swap(ratio[i], ratio[j]);
                swap(weight[i], weight[j]);
                swap(value[i], value[j]);
            }
        }
    }

    float profit = 0;

    for(int i = 0; i < n; i++) {
        if(weight[i] <= W) {
            profit += value[i];
            W -= weight[i];
        }
        else {
            profit += ratio[i] * W;
            break;
        }
    }

    cout << "Maximum profit = " << profit;

    return 0;
}
